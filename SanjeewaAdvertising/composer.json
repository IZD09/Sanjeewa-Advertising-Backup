{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "nwidart/laravel-modules": "^13.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Admin\\": "Modules/Admin/app/",
            "Modules\\Admin\\Database\\Seeders\\": "Modules/Admin/database/seeders/",
            "Modules\\Core\\": "Modules/Core/app/",
            "Modules\\Core\\Database\\Seeders\\": "Modules/Core/database/seeders/",
            "Modules\\User\\": "Modules/User/app/",
            "Modules\\User\\Database\\Seeders\\": "Modules/User/database/seeders/",
            "Modules\\Customer\\": "Modules/Customer/app/",
            "Modules\\Customer\\Database\\Seeders\\": "Modules/Customer/database/seeders/",
            "Modules\\PrintJob\\": "Modules/PrintJob/app/",
            "Modules\\PrintJob\\Database\\Seeders\\": "Modules/PrintJob/database/seeders/",
            "Modules\\Design\\": "Modules/Design/app/",
            "Modules\\Design\\Database\\Seeders\\": "Modules/Design/database/seeders/",
            "Modules\\Inventory\\": "Modules/Inventory/app/",
            "Modules\\Inventory\\Database\\Seeders\\": "Modules/Inventory/database/seeders/",
            "Modules\\Supplier\\": "Modules/Supplier/app/",
            "Modules\\Supplier\\Database\\Seeders\\": "Modules/Supplier/database/seeders/",
            "Modules\\Transaction\\": "Modules/Transaction/app/",
            "Modules\\Transaction\\Database\\Seeders\\": "Modules/Transaction/database/seeders/",
            "Modules\\UI\\": "Modules/UI/app/",
            "Modules\\UI\\Database\\Seeders\\": "Modules/UI/database/seeders/",
            "Modules\\Invoice\\": "Modules/Invoice/app/",
            "Modules\\Invoice\\Database\\Seeders\\": "Modules/Invoice/database/seeders/",
            "Modules\\Reports\\": "Modules/Reports/app/",
            "Modules\\Reports\\Database\\Seeders\\": "Modules/Reports/database/seeders/",
            "Modules\\HR\\": "Modules/HR/app/",
            "Modules\\HR\\Database\\Seeders\\": "Modules/HR/database/seeders/",
            "Modules\\Transport\\": "Modules/Transport/app/",
            "Modules\\Transport\\Database\\Seeders\\": "Modules/Transport/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
