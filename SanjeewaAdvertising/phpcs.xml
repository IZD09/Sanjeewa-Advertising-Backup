<?xml version="1.0"?>
<ruleset name="SanjeewaAdvertising">
    <description>PSR-12 coding standard customized for Laravel and PHPUnit.</description>

    <!-- Base rule: PSR-12 -->
    <rule ref="PSR12">
        <!-- Allow Laravel Pint's operator spacing conventions -->
        <exclude name="PSR12.Operators.OperatorSpacing"/>
    </rule>

    <!-- Allow snake_case test methods in PHPUnit test files -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
</ruleset>
